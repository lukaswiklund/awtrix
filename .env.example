# Copy to .env and fill in. Real environment variables override this file.
# Everything else -- region, thresholds, intervals, icons -- is a literal in
# awtrix/config.py.

# The AWTRIX device's address on your LAN.
AWTRIX_IP=192.168.1.2

DEXCOM_USERNAME=you@example.com
DEXCOM_PASSWORD=

# Docker only: the home directory holding .claude, mounted read-only so the
# claude app can read Claude Code's OAuth token. compose.yml cannot use $HOME --
# `sudo docker compose` would resolve it to /root and silently mount an empty
# directory, leaving the claude app stuck on "CC?".
CLAUDE_DIR=/home/you
